{
    "manifest_version": 3,
    "name": "ElineHR Extension",
    "version": "1.5",
    "description": "Extract LinkedIn profile data for recruitment",
    "permissions": [
        "activeTab",
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*",
        "https://*.linkedin.com/*",
        "https://media.licdn.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://www.linkedin.com/in/*",
                "https://*.linkedin.com/in/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/qr_logo.png",
            "48": "icons/favicon-150x150.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/qr_logo.png",
        "48": "icons/favicon-150x150.png"
    }
}